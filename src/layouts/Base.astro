---
import '../styles/global.css';
import { SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  /** Set on sub-pages so the nav anchors point back to the homepage. */
  subpage?: boolean;
}

const { title, description, subpage = false } = Astro.props;
const pageTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} — ${SITE.name}`;
const home = subpage ? '/' : '';

const navLinks = [
  { href: `${home}#about`, label: 'About' },
  { href: `${home}#experience`, label: 'Experience' },
  { href: `${home}#projects`, label: 'Projects' },
  { href: `${home}#skills`, label: 'Skills' },
  { href: `${home}#contact`, label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#140f1e" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preload" href="/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="shell masthead__inner">
        <a class="masthead__name" href="/">{SITE.name}</a>
        <nav class="masthead__nav" aria-label="Primary">
          {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href={SITE.resume} target="_blank" rel="noopener">
            Resume <span class="ext" aria-hidden="true">↗</span>
            <span class="sr-only"> (PDF, opens in a new tab)</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon">
      <div class="shell colophon__inner">
        <p class="colophon__place">
          <span class="colophon__pin" aria-hidden="true"></span>
          {SITE.location}
        </p>
        <div class="colophon__links">
          <a href={`mailto:${SITE.email}`}>Email</a>
          <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
          <a href={SITE.resume} target="_blank" rel="noopener">Resume</a>
        </div>
        <p>Built with Astro.</p>
      </div>
    </footer>
  </body>
</html>
