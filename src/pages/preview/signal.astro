---
import Preview from '../../layouts/Preview.astro';
import { SITE } from '../../consts';
import { timeline, KIND_LABEL } from '../../data/timeline';
import '../../styles/preview-signal.css';
---

<Preview name="Signal" stylesheet="preview-signal.css" fonts={['space-grotesk.woff2', 'manrope.woff2']}>
  <div class="signal">
    <div class="signal__shell">
      <header class="signal__top">
        <a class="signal__wordmark" href="/preview/signal">{SITE.name}</a>
        <nav class="signal__nav">
          <a href="#timeline">Timeline</a>
          <a href="/about">About</a>
          <a href={SITE.resume}>Resume</a>
          <a href={`mailto:${SITE.email}`}>Say hi</a>
        </nav>
      </header>

      <section class="signal__hero">
        <div>
          <p class="signal__status">
            <span class="signal__pulse" aria-hidden="true"></span>
            Open to PM, TPM and EM roles
          </p>
          <h1 class="signal__title">
            I ship software, and I'm moving into <em>product</em>.
          </h1>
          <p class="signal__blurb">
            Developer turning into a product and technical program manager. I like
            the systems, and I like the people they get built for.
          </p>
          <div class="signal__actions">
            <a class="signal__btn" href="#timeline">See the work</a>
            <a class="signal__btn signal__btn--ghost" href={SITE.resume}>Resume</a>
          </div>
        </div>
        <img
          class="signal__portrait"
          src="/images/disha.jpg"
          alt="Disha Nath, smiling, outdoors in front of a brick and stone wall."
          width="1000"
          height="1250"
        />
      </section>

      <section id="timeline">
        <div class="signal__section-head">
          <h2>Timeline</h2>
          <span>Most recent first</span>
        </div>

        <ol class="signal__timeline" role="list">
          {
            timeline.map((e) => {
              const Card = e.href ? 'a' : 'div';
              return (
                <li class={`signal__entry${e.current ? ' signal__entry--current' : ''}`}>
                  <span class="signal__dot" aria-hidden="true" />
                  <Card class="signal__card" href={e.href}>
                    <div class="signal__meta">
                      <span class="signal__date">{e.date}</span>
                      <span class="signal__kind">{KIND_LABEL[e.kind]}</span>
                    </div>
                    <h3 class="signal__entry-title">{e.title}</h3>
                    {e.org && <p class="signal__org">{e.org}</p>}
                    <p class="signal__body">{e.body}</p>
                    {e.href && <span class="signal__more">Read the case study →</span>}
                  </Card>
                </li>
              );
            })
          }
        </ol>
      </section>

      <footer class="signal__foot">
        <p>Let's talk — <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <p><a href={SITE.linkedin}>LinkedIn</a> · <a href={SITE.resume}>Resume</a></p>
      </footer>
    </div>
  </div>
</Preview>
