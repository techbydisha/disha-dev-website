---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
---

<Base
  title="About"
  description={`About ${SITE.name} — ${SITE.tagline}.`}
  section="about"
>
  <div class="shell page">
    <h1 class="page__title">About</h1>

    <div class="prose">
      <!--
        Replace everything below with your own prose. Plain paragraphs; add
        `## Subheads` if the page runs long. The measure and leading here are
        the same as a case study, so it will read the same way.
      -->
      <p>
        This page is a placeholder. Write two or three hundred words here in your own
        voice — where you have worked, what kind of problems you take on, and what you
        are looking for next.
      </p>
      <p>
        The layout holds a single column at the same measure as a case study, so prose
        is the only thing you need to supply. Links inside the text pick up a
        <a href="/">brass underline</a> automatically.
      </p>
    </div>
  </div>
</Base>
