---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';

const studies = (await getCollection('work'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title={SITE.name} description={SITE.tagline} section="work">
  <div class="shell">
    <section class="hero">
      <div>
        <!--
          Your positioning statement. Keep it first person and keep it short —
          it is the largest type on the site. Wrap one phrase in <em> to put
          the gold accent on it.
        -->
        <h1 class="hero__statement">
          I’m Disha. I build software, and I’m moving into <em>product</em>.
        </h1>
        <p class="hero__note">
          Software developer working toward product and technical program management.
          Three case studies below — each one opens with the decision it turned on.
        </p>
        <a class="hero__cta" href="#work">Read the work →</a>
      </div>

      <img
        class="hero__portrait"
        src="/images/disha.jpg"
        alt="Disha Nath, smiling, outdoors in front of a brick and stone wall."
        width="1000"
        height="1250"
        fetchpriority="high"
      />
    </section>

    <h2 class="sr-only" id="work">Case studies</h2>

    <div class="rows">
      {
        studies.map((study) => (
          <article class="row">
            <h3 class="row__title">
              <a href={`/work/${study.id}`}>{study.data.title}</a>
            </h3>
            <p class="row__claim">{study.data.claim}</p>
            <p class="row__meta">
              <span>
                {study.data.role} · {study.data.timeframe}
              </span>
              <span class="row__read" aria-hidden="true">Read →</span>
            </p>
          </article>
        ))
      }
    </div>
  </div>
</Base>
